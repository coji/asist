<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for running Electron under the hardened runtime with microphone capture. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone input. It pairs with NSMicrophoneUsageDescription, and the TCC permission persists only
       with an Apple Development signature or stronger. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Electron's V8 uses a JIT, which the hardened runtime allows only when it is granted explicitly. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
